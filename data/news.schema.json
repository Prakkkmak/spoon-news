{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakkkmak/spoon-news/blob/main/data/news.schema.json",
  "title": "Spoon News — news",
  "description": "Flux des grosses cartes d'actualité éditoriales jouées en rotation.",
  "type": "object",
  "required": ["schema_version", "updated_at", "news"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version du schéma de ce fichier."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage ISO 8601 de la dernière modification du fichier."
    },
    "news": {
      "type": "array",
      "minItems": 1,
      "description": "Liste des cartes d'actualité éditées.",
      "items": { "$ref": "#/$defs/newsItem" }
    }
  },
  "$defs": {
    "newsItem": {
      "type": "object",
      "required": ["category", "headline", "chapo", "published_at"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "Rubrique en majuscules (ex. \"POLITIQUE\", \"SPORT\")."
        },
        "location": {
          "type": "string",
          "description": "Lieu de l'actualité, en majuscules (ex. \"PARIS\", \"GENÈVE\")."
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "description": "Date/heure ISO 8601 de publication. Le client calcule l'âge (« il y a X min »)."
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "description": "Titre principal de la carte."
        },
        "chapo": {
          "type": "string",
          "minLength": 1,
          "description": "Paragraphe d'introduction qui développe le titre."
        },
        "sources": {
          "type": "array",
          "description": "Sources de l'information (remplace l'ancien champ `credit`).",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Nom court de la source (ex. \"AFP\", \"Reuters\")."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Lien vers l'article ou la dépêche d'origine."
              }
            }
          }
        },
        "illustration": {
          "type": "string",
          "enum": ["cityscape", "globe", "chart", "stadium", "planet", "generic"],
          "description": "Clé de l'illustration SVG (cf. assets/svgs.js)."
        },
        "data_label": {
          "type": "string",
          "description": "Titre du bloc de données complémentaire (ex. \"LES CHIFFRES DU VOTE\")."
        },
        "data": { "$ref": "#/$defs/dataBlock" }
      }
    },
    "dataBlock": {
      "description": "Bloc de données complémentaire de la carte. Le champ `type` détermine la forme.",
      "oneOf": [
        { "$ref": "#/$defs/dataGrid" },
        { "$ref": "#/$defs/dataQuote" },
        { "$ref": "#/$defs/dataBullets" }
      ]
    },
    "dataGrid": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "grid" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["num", "lbl"],
            "additionalProperties": false,
            "properties": {
              "num": {
                "type": "string",
                "description": "Valeur mise en avant (chiffre, pourcentage, durée)."
              },
              "lbl": {
                "type": "string",
                "description": "Légende courte sous la valeur."
              }
            }
          }
        }
      }
    },
    "dataQuote": {
      "type": "object",
      "required": ["type", "text", "cite"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "quote" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Texte de la citation, sans guillemets."
        },
        "cite": {
          "type": "string",
          "minLength": 1,
          "description": "Auteur ou source de la citation."
        }
      }
    },
    "dataBullets": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "bullets" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "updated_at": "2026-04-29T08:00:00",
      "news": [
        {
          "category": "POLITIQUE",
          "location": "PARIS",
          "published_at": "2026-04-29T07:48:00",
          "headline": "Budget 2026 : l'Assemblée vote le projet après dix heures de débats",
          "chapo": "Le texte est adopté malgré une opposition vive sur les mesures fiscales. Le gouvernement évite la motion de censure.",
          "sources": [
            { "name": "AFP", "url": "https://www.afp.com/fr/infos/exemple-budget-2026" },
            { "name": "Le Monde", "url": "https://www.lemonde.fr/exemple" }
          ],
          "illustration": "cityscape",
          "data_label": "LES CHIFFRES DU VOTE",
          "data": {
            "type": "grid",
            "items": [
              { "num": "287", "lbl": "Pour" },
              { "num": "245", "lbl": "Contre" },
              { "num": "18",  "lbl": "Abstentions" }
            ]
          }
        }
      ]
    }
  ]
}
